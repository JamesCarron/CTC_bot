# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets / session state
.env
secrets/
wa_session/
*.session

# Data: raw snapshots and derived sets are regenerable
data/raw/*
!data/raw/.gitkeep
data/events/*
!data/events/.gitkeep
data/exports/*
!data/exports/.gitkeep
out/*
!out/.gitkeep
