# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets / session state
.env
secrets/

# Data: raw snapshots and derived sets are regenerable
data/raw/*
!data/raw/.gitkeep
data/events/*
!data/events/.gitkeep
out/*
!out/.gitkeep

# Athlete claims: personal data, and local state rather than code.
# Back this up separately - losing it loses every claim.
data/identity.json
