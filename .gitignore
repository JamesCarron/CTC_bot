# Pixi: the solved environment is large and regenerable from pixi.lock,
# which IS committed so everyone resolves identical package versions.
.pixi/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets. Credentials are stored outside the repo entirely
# (%LOCALAPPDATA%\CTC_bot), but keep these as a backstop.
.env
secrets/
credentials.bin
*.credentials

# Data: raw snapshots and derived sets are regenerable
data/raw/*
!data/raw/.gitkeep
data/events/*
!data/events/.gitkeep
out/*
!out/.gitkeep

# Working scratch: raw page dumps and run logs. The session notes in
# working/*.md are tracked; these are not.
working/*.html
working/*.log

# Athlete claims: personal data, and local state rather than code.
# Back this up separately - losing it loses every claim.
data/identity.json
# pixi environments
.pixi/*
!.pixi/config.toml
